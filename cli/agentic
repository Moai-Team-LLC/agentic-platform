# ── phase / brief / act — the living-roadmap orchestrator ─────────────────────
# phase: declare WHERE each project is on the path to money (7 phases, 6 fields,
# ~/.agentic-cockpit/phases.json). brief: a daily focus digest ranked by money —
# what to push, what's burning, what to kill, and how sprawled you are. act: runs
# the phase-appropriate sub-agent (claude -p) — shipped→outreach, sunset→verify, etc.
PHASES_FILE="${AGENTIC_PHASES:-$HOME/.agentic-cockpit/phases.json}"
_valid_phase() { case "$1" in idea|building|shipped|live|earning|frozen|sunset) return 0;; *) return 1;; esac; }

phase_seed() {
  local snap="$HOME/.agentic-cockpit/snapshot.json"
  [ -f "$snap" ] || { bad "no snapshot — run: agentic snapshot"; return 1; }
  PHASES="$PHASES_FILE" SNAP="$snap" PYTHONIOENCODING=utf-8 python3 -c '
import os,json,datetime
ph,snap=os.environ["PHASES"],os.environ["SNAP"]
d=json.load(open(snap,encoding="utf-8"))
prod={p.get("name",""):(p.get("code","") or "") for p in d.get("prod",[])}
ok=lambda c: c[:1] in ("2","3")
cur={}
if os.path.exists(ph):
    try: cur=json.load(open(ph,encoding="utf-8"))
    except Exception: cur={}
today=datetime.date.today().isoformat(); added=0
for r in d.get("repos",[]):
    n=r.get("name","")
    if not n or n in cur: continue          # never clobber a declared phase
    age=r.get("age_days") or 999; code=prod.get(n,"")
    if r.get("gone"): phase="sunset"
    elif code and ok(code): phase="shipped" if age<30 else "frozen"
    elif code: phase="shipped"
    elif age<21: phase="building"
    else: phase="frozen"
    cur[n]={"phase":phase,"next":"","blocker":"","money":"none","focus":False,"updated":today}
    added+=1
json.dump(cur,open(ph,"w",encoding="utf-8"),ensure_ascii=False,indent=1)
print("  seeded %d projects (declared phases kept, edit with: agentic phase <repo> <phase>)"%added)'
  ok "phases → $(c '1;4;36' "$PHASES_FILE")"
}

phase_show() {
  [ -f "$PHASES_FILE" ] || { warn "no phases yet — run: agentic phase seed"; return 0; }
  PHASES="$PHASES_FILE" PYTHONIOENCODING=utf-8 python3 -c '
import os,json,datetime
d=json.load(open(os.environ["PHASES"],encoding="utf-8"))
order={"earning":0,"live":1,"shipped":2,"building":3,"idea":4,"frozen":5,"sunset":6}
