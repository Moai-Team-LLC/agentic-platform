  local reg="${AGENTIC_COCKPIT_REG:-$HOME/.agentic-cockpit/repos.json}"
  [ -f "$reg" ] || { bad "no repo registry at $(c '1;37' "$reg")"; return 1; }
  local out="$HOME/.agentic-cockpit/snapshot.json"
  say "building portfolio snapshot (git × N + prod pings)…"
  local repos prod at
  repos="$(cmd_code_status --json 2>/dev/null)"
  prod="$(cmd_prod_health --json 2>/dev/null)"
  at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  REPOS_JSON="$repos" PROD_JSON="$prod" AT="$at" OUT="$out" PYTHONIOENCODING=utf-8 python3 -c '
import os,json
o={"repos":json.loads(os.environ.get("REPOS_JSON") or "[]"),
   "prod":json.loads(os.environ.get("PROD_JSON") or "[]"),
