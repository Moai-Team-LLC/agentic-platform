# memory context for a name (project or repo) — headless claude -p has no MCP,
# so we hand it the founder's own notes so the sub-agent isn't blind.
_enrich() {
  local mem="$HOME/.claude/projects/-Users-duchenchuk-Documents-ClaudeCode/memory"
  [ -f "$mem/MEMORY.md" ] && grep -iF "$1" "$mem/MEMORY.md" 2>/dev/null | sed 's/^- //' | head -15
}
# dispatch a sub-agent: label stage prompt run ctx
_dispatch() {
  local label="$1" stage="$2" prompt="$3" run="$4" ctx="$5" cwd="${6:-}"
  [ -n "$ctx" ] && prompt="Context on '$label' from the founder's own notes — use it, do not ask what you can infer:
$ctx

$prompt"
  say "$(c '1;37' "$label") — $(c '1;33' "$stage") → sub-agent$([ -n "$ctx" ] && echo ' (+context)')"
  echo "  $(c '1;36' 'prompt:') $prompt"
  if [ "$run" = 1 ]; then
    command -v claude >/dev/null || { bad "claude CLI not on PATH"; return 1; }
    echo ""; say "running sub-agent (claude -p)$([ -n "$cwd" ] && echo " in $cwd — reads the real code")…"; echo ""
    if [ -n "$cwd" ] && [ -d "$cwd" ]; then ( cd "$cwd" && claude -p "$prompt" ); else claude -p "$prompt"; fi
  else
    echo ""; echo "  $(c '2' 'dry-run — add --run to dispatch via claude -p')"
  fi
}

# business agent on a PROJECT (money phase — we sell projects)
cmd_act() {
  local name="${1:-}" run=0
  for a in "$@"; do [ "$a" = "--run" ] && run=1; done
  [ -n "$name" ] && [ "$name" != "--run" ] || { bad "usage: agentic act <project> [--run]"; return 1; }
  [ -f "$PROJECTS_FILE" ] || { bad "no projects — run: agentic project seed"; return 1; }
  local phase
  phase="$(NAME="$name" PROJ="$PROJECTS_FILE" python3 -c 'import os,json;d=json.load(open(os.environ["PROJ"],encoding="utf-8"));print((d.get(os.environ["NAME"]) or {}).get("phase",""))' 2>/dev/null)"
  [ -n "$phase" ] || { bad "no project '$name' — see: agentic project show"; return 1; }
  local prompt
  case "$phase" in
    idea)     prompt="Validate market demand for project '$name'. Is there a paying audience and a real, urgent pain? Give a blunt go / no-go.";;
    building) prompt="Project '$name' is in development. List the concrete gaps remaining before it can ship to a first real user.";;
    shipped)  prompt="Project '$name' is deployed but has ZERO paying users. Draft a 2-week GTM plan, no code: 5 concrete outreach targets, a cold-email template, a demo script, and the exact path to the first paying customer.";;
    live)     prompt="Project '$name' has users but no revenue. How to turn users into payers: billing readiness, the activation moment, the smallest paywall to take money this week.";;
    earning)  prompt="Project '$name' has paying users. Top 3 growth/retention levers ranked by effort-to-impact.";;
    frozen)   warn "'$name' is frozen — no action by design (monitor only)."; return 0;;
    sunset)   prompt="Project '$name' is marked for deletion. Verify its work is merged into its canonical repos before deleting; report SAFE-TO-DELETE or exactly what would be lost.";;
    *) bad "unknown phase '$phase'"; return 1;;
  esac
  _dispatch "$name" "$phase" "$prompt" "$run" "$(_enrich "$name")"
}

# engineering agent on a REPO (SDLC stage — dev happens per repo)
cmd_dev() {
  local repo="${1:-}" run=0
  for a in "$@"; do [ "$a" = "--run" ] && run=1; done
  [ -n "$repo" ] && [ "$repo" != "--run" ] || { bad "usage: agentic dev <repo> [--run]"; return 1; }
  [ -f "$PROJECTS_FILE" ] || { bad "no projects — run: agentic project seed"; return 1; }
  local stage path
  stage="$(REPO="$repo" PROJ="$PROJECTS_FILE" python3 -c 'import os,json
d=json.load(open(os.environ["PROJ"],encoding="utf-8")); r=os.environ["REPO"]
for pr,p in d.items():
    if r in p.get("repos",{}):
        print(p["repos"][r] or ""); break' 2>/dev/null)"
  [ -n "$stage" ] || { bad "no SDLC stage for '$repo' — set: agentic sdlc $repo <stage>"; return 1; }
  path="$(REPO="$repo" REG="${AGENTIC_COCKPIT_REG:-$HOME/.agentic-cockpit/repos.json}" python3 -c 'import os,json;d={r["name"]:r["path"] for r in json.load(open(os.environ["REG"],encoding="utf-8"))};print(d.get(os.environ["REPO"],""))' 2>/dev/null)"
  local prompt
  case "$stage" in
    design)   prompt="Repo '$repo' at $path is in DESIGN. Pressure-test the approach: architecture risks, simpler alternatives, what to decide before coding.";;
    build)    prompt="Repo '$repo' at $path is in BUILD. Review the current code and list concrete gaps before it is test-ready. Cite files.";;
    test)     prompt="Repo '$repo' at $path is in TEST. Identify coverage gaps and the highest-value tests to add before deploy.";;
    deploy)   prompt="Repo '$repo' at $path is ready to DEPLOY. Produce a deploy-readiness checklist: migrations, env, rollback, health checks, known gotchas.";;
    maintain) prompt="Repo '$repo' at $path is in MAINTAIN. Surface the top tech-debt and reliability risks, ranked by effort-to-impact.";;
    *) bad "unknown stage '$stage'"; return 1;;
  esac
  _dispatch "$repo" "$stage" "$prompt" "$run" "$(_enrich "$repo")" "$path"
}

# ── project / sdlc — two-axis model ───────────────────────────────────────────
# A PROJECT is the business unit (we sell projects, not repos): it carries the
# money phase. It groups one or more REPOS, each with its own SDLC stage (the
# engineering axis — dev happens per repo). projects.json holds both.
PROJECTS_FILE="${AGENTIC_PROJECTS:-$HOME/.agentic-cockpit/projects.json}"
_valid_sdlc() { case "$1" in design|build|test|deploy|maintain) return 0;; *) return 1;; esac; }

project_seed() {
  local snap="$HOME/.agentic-cockpit/snapshot.json"
  [ -f "$snap" ] || { bad "no snapshot — run: agentic snapshot"; return 1; }
  PROJ="$PROJECTS_FILE" SNAP="$snap" PYTHONIOENCODING=utf-8 python3 -c '
import os,json,datetime
proj,snap=os.environ["PROJ"],os.environ["SNAP"]
d=json.load(open(snap,encoding="utf-8"))
prod={p.get("name",""):(p.get("code","") or "") for p in d.get("prod",[])}
ok=lambda c: c[:1] in ("2","3")
# explicit multi-repo groupings (edit later with: agentic project <name> --repos ...)
GROUPS={
 "moai":["moai-next","moai-team-cms","moai-cms-front","moai-ads","moai-dot-github"],
 "unlock":["Unlock","unlock-landing","unlock-cms","unlock-cms-front"],
 "fcy":["fcy-app-dev","fcy-app-rnd","fcy-knowledge-ts"],
 "founders-impact":["founders-impact-os","donate-founders-cy"],
 "playerpulse":["player-pulse-backend","player-pulse-frontend"],
 "social-graph":["Social Graph Drizzle","Social Graph Fork"],
 "knowledge-junk":["Knowledge AI Drizzle","Marketplace Drizzle","Knowledge Layer Local","MyKnowledgeLayer","qust-source","PAI"],
 "agentic-platform":["agentic-platform","AgenticMind","AgenticMind-stack","AgenticGateway","AgenticGateway-stack","AgenticOps","AgenticOps-stack","AgenticPerformance-stack","AgenticAssurance","agent-assurance","AgenticSelfHealingCode-stack","Self-healing code","apl","aal-evidence","agentic-product-standard","agentic-product-standard-stack","apg-std-org","agenticmind-org","ashc"],
}
r2p={}
for pr,rs in GROUPS.items():
    for r in rs: r2p[r]=pr
cur={}
if os.path.exists(proj):
    try: cur=json.load(open(proj,encoding="utf-8"))
    except Exception: cur={}
today=datetime.date.today().isoformat()
# build project -> {repos, freshest age, any prod}
agg={}
for r in d.get("repos",[]):
    n=r.get("name","")
    if not n: continue
    pr=r2p.get(n,n)
    a=agg.setdefault(pr,{"repos":[],"age":999,"prod":False,"gone":True})
    a["repos"].append(n)
    a["age"]=min(a["age"], r.get("age_days") or 999)
    if ok(prod.get(n,"")): a["prod"]=True
    if not r.get("gone"): a["gone"]=False
added=0
for pr,a in agg.items():
    if pr in cur:  # keep declared project (phase/money/focus), but rebuild repo
        old=cur[pr].get("repos",{})  # membership from the live snapshot (drops deleted repos, keeps sdlc)
        cur[pr]["repos"]={n:old.get(n,"") for n in a["repos"]}
        continue
    if pr=="knowledge-junk": phase="sunset"
    elif a["gone"]: phase="sunset"
    elif a["prod"]: phase="shipped" if a["age"]<30 else "frozen"
    elif a["age"]<21: phase="building"
    else: phase="frozen"
    cur[pr]={"repos":{n:"" for n in a["repos"]},"phase":phase,"money":"none","focus":False,"next":"","blocker":"","updated":today}
    added+=1
json.dump(cur,open(proj,"w",encoding="utf-8"),ensure_ascii=False,indent=1)
print("  grouped %d repos → %d projects (%d new). Fix membership: agentic project <name> --repos a,b,c"%(len(d.get("repos",[])),len(cur),added))'
  ok "projects → $(c '1;4;36' "$PROJECTS_FILE")"
}

project_show() {
  [ -f "$PROJECTS_FILE" ] || { warn "no projects yet — run: agentic project seed"; return 0; }
  PROJ="$PROJECTS_FILE" PYTHONIOENCODING=utf-8 python3 -c '
import os,json
d=json.load(open(os.environ["PROJ"],encoding="utf-8"))
order={"earning":0,"live":1,"shipped":2,"building":3,"idea":4,"frozen":5,"sunset":6}
mrank={"paying":0,"near":1,"users":2,"none":3}
def col(s,c): return "\033[%sm%s\033[0m"%(c,s)
PC={"earning":"1;32","live":"1;36","shipped":"1;33","building":"2","idea":"2","frozen":"2","sunset":"1;31"}
MC={"paying":"1;32","near":"1;33","users":"1;36","none":"2"}
rows=sorted(d.items(),key=lambda kv:(order.get(kv[1].get("phase"),9),mrank.get(kv[1].get("money"),9)))
print()
print("  "+col("%-20s %-9s %-7s %-6s %-5s %s"%("PROJECT","PHASE","MONEY","FOCUS","REPOS","NEXT"),"1;37"))
for n,p in rows:
    ph=p.get("phase","?"); mo=p.get("money","none"); nr=len(p.get("repos",{}))
    foc=col("●","1;36") if p.get("focus") else col("·","2")
    print("  %-20s %s %s %-6s %-5s %s"%(n,col("%-9s"%ph,PC.get(ph,"0")),col("%-7s"%mo,MC.get(mo,"0")),foc,nr,col((p.get("next") or "")[:44],"2")))
nf=sum(1 for _,p in rows if p.get("focus"))
ship=sum(1 for _,p in rows if p.get("phase")=="shipped")
print()
line="  "+col("%d projects"%len(rows),"1;36")+" (было 57 репо) · "+col("%d in focus"%nf,"1;36" if nf<=7 else "1;31")
if ship: line+=" · "+col("%d shipped"%ship,"1;33")
print(line)'
}

project_set() {
  local name="${1:-}"; shift 2>/dev/null || true
  [ -n "$name" ] || { bad "usage: agentic project <name> [--repos a,b,c] [--phase P] [--money M] [--focus|--nofocus] [--next ..] [--blocker ..]"; return 1; }
  local repos="" phase="" money="" focus="" next="" blocker="" addr="" del=0
  while [ $# -gt 0 ]; do case "$1" in
    --delete) del=1; shift;;
    --add-repos) addr="${2:-}"; shift 2;;
    --repos) repos="${2:-}"; shift 2;;
    --phase) phase="${2:-}"; shift 2;;
    --money) money="${2:-}"; shift 2;;
    --focus) focus="true"; shift;;
    --nofocus) focus="false"; shift;;
    --next) next="${2:-}"; shift 2;;
    --blocker) blocker="${2:-}"; shift 2;;
    *) shift;;
  esac; done
  [ -z "$phase" ] || _valid_phase "$phase" || { bad "bad phase '$phase'"; return 1; }
  [ -z "$money" ] || case "$money" in none|near|users|paying);; *) bad "money: none|near|users|paying"; return 1;; esac
  NAME="$name" REPOS="$repos" ADDR="$addr" DEL="$del" PHASE="$phase" MONEY="$money" FOCUS="$focus" NEXT="$next" BLOCKER="$blocker" PROJ="$PROJECTS_FILE" PYTHONIOENCODING=utf-8 python3 -c '
import os,json,datetime
proj=os.environ["PROJ"]; cur={}
if os.path.exists(proj):
    try: cur=json.load(open(proj,encoding="utf-8"))
    except Exception: cur={}
e=os.environ; n=e["NAME"]
if e.get("DEL")=="1":
    cur.pop(n,None); json.dump(cur,open(proj,"w",encoding="utf-8"),ensure_ascii=False,indent=1); print("  deleted "+n); raise SystemExit
r=cur.get(n,{"repos":{},"phase":"","money":"none","focus":False,"next":"","blocker":"","updated":""})
if e.get("REPOS"):
    old=r.get("repos",{}); r["repos"]={x.strip():old.get(x.strip(),"") for x in e["REPOS"].split(",") if x.strip()}
if e.get("ADDR"):
    for x in e["ADDR"].split(","):
        x=x.strip()
        if x: r["repos"][x]=r["repos"].get(x,"")
for k in ("PHASE","MONEY","NEXT","BLOCKER"):
    if e.get(k): r[k.lower()]=e[k]
if e.get("FOCUS"): r["focus"]=(e["FOCUS"]=="true")
r["updated"]=datetime.date.today().isoformat()
cur[n]=r
json.dump(cur,open(proj,"w",encoding="utf-8"),ensure_ascii=False,indent=1)
print("  %s → phase=%s money=%s focus=%s repos=%d"%(n,r["phase"],r["money"],r["focus"],len(r["repos"])))'
  ok "project updated"
}

cmd_project() {
  case "${1:-show}" in
    seed) project_seed;;
    show) project_show;;
    *) project_set "$@";;
  esac
}

cmd_sdlc() {
  [ -f "$PROJECTS_FILE" ] || { bad "no projects — run: agentic project seed"; return 1; }
  if [ -z "${1:-}" ] || [ "$1" = "show" ]; then
    PROJ="$PROJECTS_FILE" PYTHONIOENCODING=utf-8 python3 -c '
import os,json
d=json.load(open(os.environ["PROJ"],encoding="utf-8"))
def col(s,c): return "\033[%sm%s\033[0m"%(c,s)
STAGES=["design","build","test","deploy","maintain","(unset)"]
buck={s:[] for s in STAGES}
for pr,p in d.items():
    for r,st in p.get("repos",{}).items():
        buck[st if st in STAGES else "(unset)"].append((r,pr))
print()
for s in STAGES:
    items=buck[s]
    if not items and s=="(unset)": continue
    print("  "+col("%-9s"%s,"1;37" if s!="(unset)" else "2")+col(" %d"%len(items),"2"))
    for r,pr in items[:40]: print("     %s %s"%(r,col("· "+pr,"2")))'
    return
  fi
  # set: agentic sdlc <repo> <stage>
  local repo="$1" stage="${2:-}"
  [ -n "$stage" ] || { bad "usage: agentic sdlc <repo> <stage>  (design|build|test|deploy|maintain)"; return 1; }
  _valid_sdlc "$stage" || { bad "stage: design|build|test|deploy|maintain"; return 1; }
  REPO="$repo" STAGE="$stage" PROJ="$PROJECTS_FILE" PYTHONIOENCODING=utf-8 python3 -c '
import os,json
proj=os.environ["PROJ"]; d=json.load(open(proj,encoding="utf-8"))
repo=os.environ["REPO"]; stage=os.environ["STAGE"]; found=None
for pr,p in d.items():
    if repo in p.get("repos",{}): found=pr; p["repos"][repo]=stage; break
if not found:
    import sys; sys.stderr.write("repo not in any project — check: agentic project show\n"); sys.exit(3)
json.dump(d,open(proj,"w",encoding="utf-8"),ensure_ascii=False,indent=1)
print("  %s → sdlc=%s (project %s)"%(repo,stage,found))' || { bad "repo '$repo' not found in any project"; return 1; }
  ok "sdlc updated"
}

usage() {
  cat <<'USAGE'
agentic — the Agentic Platform control plane

  agentic init <name> [port-base] [profiles]
                           stamp a NEW engine instance (own name/ports/secrets/profiles)
  agentic handout          write handout.md — endpoints + creds for the product team
  agentic up               build + start the whole stack, wired
  agentic down             stop the stack (data volumes preserved)
  agentic status           aggregate health verdict + per-service states
  agentic code-status      portfolio git status across all your repos (host, registry-driven)
  agentic prod-health [--disk]  ping every prod URL (+ ssh droplet disk) from the registry
  agentic deploy <repo> [--run] show (or run) a repo's deploy command, forced `cd` into it
  agentic cockpit          render + open the HTML portfolio panel (git + prod, host-native)
  agentic model <path> [--check]  living structural model of a repo + drift check (experimental)
  agentic snapshot         write portfolio snapshot → console's Portfolio tab (fuses cockpit in)
  agentic project [<name> ...]  business unit — group repos into projects, set money phase
  agentic sdlc [<repo> <stage>]  engineering axis — per-repo stage (design|build|test|deploy|maintain)
  agentic phase [<repo> <phase>]  living roadmap — declare/show where each project is (7 phases)
  agentic brief            daily focus digest — ranked by money, what to push/kill, sprawl
  agentic act <project> [--run]  business sub-agent for a project's money phase (shipped→GTM)
  agentic dev <repo> [--run]  engineering sub-agent for a repo's SDLC stage (build→review, deploy→checklist)
  agentic doctor           end-to-end readiness (routing + Claude's MCP path)
  agentic ask "question"   ask AgenticMind a question from the terminal
  agentic ingest <path>    add a file / a directory of .md,.txt into the knowledge base
  agentic backup           dump all databases → ~/.agentic-backups
  agentic restore <dir>    restore databases from a backup directory
  agentic outdated         show how far vendored parts are behind upstream
  agentic update [name…]   absorb upstream: snapshot → bump pins → rebuild → verify
  agentic sync             apply committed pins (after git pull / fresh clone) + rebuild
  agentic console          open the console (http://127.0.0.1:4600)
  agentic app              open the console as a desktop-style window (Chrome app mode)
  agentic dockapp          create ~/Applications/Agentic Console.app + pin it to the Dock
  agentic menubar          install the menu-bar control (SwiftBar: health + start/stop)
  agentic demo             run the closed-loop demo (ask → route → trace → scan)
  agentic token [label]    mint an MCP token for AgenticMind (for Claude Code)
  agentic install          put `agentic` on your PATH (~/.local/bin)
  agentic logs [service]   tail a service's logs
USAGE
}

case "${1:-}" in
  init) shift; cmd_init "$@" ;; handout) cmd_handout ;;
  up) cmd_up ;; down) cmd_down ;; status) cmd_status ;; doctor) cmd_doctor ;;
  code-status|repos) shift 2>/dev/null || true; cmd_code_status "$@" ;;
  prod-health|health) shift 2>/dev/null || true; cmd_prod_health "$@" ;;
  deploy) shift; cmd_deploy "$@" ;;
  cockpit|panel) cmd_cockpit ;;
  model) shift; cmd_model "$@" ;;
  snapshot) cmd_snapshot ;;
  project) shift 2>/dev/null || true; cmd_project "$@" ;;
  sdlc) shift 2>/dev/null || true; cmd_sdlc "$@" ;;
  phase) shift 2>/dev/null || true; cmd_phase "$@" ;;
  brief) cmd_brief ;;
  act) shift; cmd_act "$@" ;;
  dev) shift; cmd_dev "$@" ;;
  console) cmd_console ;; app) cmd_app ;; dockapp) cmd_dockapp ;; menubar) cmd_menubar ;;
  demo) cmd_demo ;; install) cmd_install ;;
  ask) shift; cmd_ask "$@" ;; ingest) shift; cmd_ingest "$@" ;;
  backup) shift; cmd_backup "$@" ;; restore) shift; cmd_restore "$@" ;;
  outdated) cmd_outdated ;; update) shift; cmd_update "$@" ;; sync) cmd_sync ;;
  token) shift; cmd_token "$@" ;; logs) shift; cmd_logs "$@" ;;
  *) usage ;;
esac
