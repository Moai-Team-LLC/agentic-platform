phase_set() {
  local repo="${1:-}" phase="${2:-}"; shift 2 2>/dev/null || true
  [ -n "$repo" ] && [ -n "$phase" ] || { bad "usage: agentic phase <repo> <phase> [--next ..] [--blocker ..] [--money none|near|users|paying] [--focus|--nofocus]"; return 1; }
  _valid_phase "$phase" || { bad "unknown phase '$phase' — one of: idea building shipped live earning frozen sunset"; return 1; }
  local next="" blocker="" money="" focus=""
  while [ $# -gt 0 ]; do case "$1" in
    --next) next="${2:-}"; shift 2;;
    --blocker) blocker="${2:-}"; shift 2;;
    --money) money="${2:-}"; shift 2;;
    --focus) focus="true"; shift;;
    --nofocus) focus="false"; shift;;
    *) shift;;
  esac; done
  if [ -n "$money" ]; then case "$money" in none|near|users|paying);; *) bad "money must be: none|near|users|paying"; return 1;; esac; fi
  REPO="$repo" PHASE="$phase" NEXT="$next" BLOCKER="$blocker" MONEY="$money" FOCUS="$focus" PHASES="$PHASES_FILE" PYTHONIOENCODING=utf-8 python3 -c '
import os,json,datetime
ph=os.environ["PHASES"]; cur={}
if os.path.exists(ph):
    try: cur=json.load(open(ph,encoding="utf-8"))
    except Exception: cur={}
e=os.environ; n=e["REPO"]
r=cur.get(n,{"phase":"","next":"","blocker":"","money":"none","focus":False})
r["phase"]=e["PHASE"]
if e.get("NEXT"): r["next"]=e["NEXT"]
if e.get("BLOCKER"): r["blocker"]=e["BLOCKER"]
if e.get("MONEY"): r["money"]=e["MONEY"]
if e.get("FOCUS"): r["focus"]=(e["FOCUS"]=="true")
r["updated"]=datetime.date.today().isoformat()
cur[n]=r
json.dump(cur,open(ph,"w",encoding="utf-8"),ensure_ascii=False,indent=1)
print("  %s → %s (money=%s focus=%s)"%(n,r["phase"],r["money"],r["focus"]))'
  ok "phase updated"
}

cmd_phase() {
  case "${1:-show}" in
    seed) phase_seed;;
    show) phase_show;;
    *) phase_set "$@";;
  esac
}

